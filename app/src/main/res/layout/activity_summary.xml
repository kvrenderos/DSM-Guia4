<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_surface"
    android:fillViewport="true"
    tools:context=".SummaryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:background="@drawable/avatar_circle"
            android:contentDescription="@string/app_name"
            android:padding="22dp"
            android:src="@drawable/ic_profile"
            android:tint="@color/profile_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Perfil guardado"
            android:textColor="@color/profile_ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/card_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView style="@style/SummaryLabel" android:text="Nombres y apellidos" />
            <TextView android:id="@+id/txtSummaryName" style="@style/SummaryValue" />

            <TextView style="@style/SummaryLabel" android:text="Correo electronico" />
            <TextView android:id="@+id/txtSummaryEmail" style="@style/SummaryValue" />

            <TextView style="@style/SummaryLabel" android:text="Numero de telefono" />
            <TextView android:id="@+id/txtSummaryPhone" style="@style/SummaryValue" />

            <TextView style="@style/SummaryLabel" android:text="Fecha de nacimiento" />
            <TextView android:id="@+id/txtSummaryBirthDate" style="@style/SummaryValue" />

            <TextView style="@style/SummaryLabel" android:text="Direccion de residencia" />
            <TextView
                android:id="@+id/txtSummaryAddress"
                style="@style/SummaryValue"
                android:layout_marginBottom="0dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnHome"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/button_primary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="Regresar al inicio"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnNewProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_outline"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="Nuevo perfil"
            android:textColor="@color/profile_primary"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
